{
  "schemaVersion": 1,
  "id": "penguin-client-fabric",
  "version": "${version}",
  "name": "PenguinClient-Fabric",
  "description": "HuHoBot Penguin 客户端模组 - 连接 QQ 群与 Minecraft 游戏聊天",
  "authors": [
    "HuHoBot"
  ],
  "contact": {
    "sources": "https://github.com/HuHoBot/PenguinClient"
  },
  "license": "MIT",
  "icon": "assets/penguin-client-fabric/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.huhobot.penguin.PenguinClientMod"
      }
    ]
  },
  "mixins": [
    "penguin-client-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": ">=0.92.9+1.20.1",
    "fabric-language-kotlin": ">=1.13.0+kotlin.2.3.0",
    "minecraft": "~1.20.1"
  },
  "suggests": {
    "another-mod": "*"
  }
}
